# --- Database -------------------------------------------------------------
# MongoDB must run as a replica set (Prisma requires it for transactions).
# The bundled docker-compose.yml starts a single-node replica set named "rs0".
DATABASE_URL="mongodb://localhost:27017/news"

# --- JWT ------------------------------------------------------------------
# Use long random strings in production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters-long"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# --- App ------------------------------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"

# --- AI chatbot (optional, only needed for the /chat endpoints) -----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
ANTHROPIC_MAX_TOKENS=1024
GOOGLE_API_KEY=""
GOOGLE_EMBEDDING_MODEL="gemini-embedding-001"
